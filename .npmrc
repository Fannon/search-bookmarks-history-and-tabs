# Keep dependency installs locked and save future additions as exact versions.
package-lock=true
save-exact=true

# Enforce declared runtime requirements and verify registry TLS.
engine-strict=true
strict-ssl=true

# Block install lifecycle scripts; required project tasks run explicitly.
ignore-scripts=true

# Retain a strict script-decision guard if scripts are manually enabled.
strict-allow-scripts=true

# Delay newly published package versions during dependency resolution.
min-release-age=2
